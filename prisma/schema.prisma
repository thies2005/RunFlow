// Database schema for RunFlow
// Stores Strava activities, race goals, and training metrics

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  
  // Strava OAuth tokens
  stravaId          String?   @unique
  stravaAccessToken String?
  stravaRefreshToken String?
  stravaTokenExpiry  DateTime?
  
  // Athlete profile for calculations
  sex           Sex       @default(MALE)
  birthDate     DateTime?
  hrMax         Int?      // Maximum heart rate
  hrRest        Int?      // Resting heart rate
  weight        Float?    // kg
  
  // Sync status
  lastSyncAt    DateTime?
  syncInProgress Boolean  @default(false)
  
  // Relations
  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  goals         Goal[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Sex {
  MALE
  FEMALE
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Activities
// ============================================

model Activity {
  id          String   @id @default(cuid())
  userId      String
  stravaId    BigInt   @unique
  
  // Activity type
  type        ActivityType
  sportType   String?       // Strava's sport_type field
  
  // Basic metrics
  name        String
  description String?
  startDate   DateTime
  timezone    String?
  
  // Distance & Duration
  distance    Float         // meters
  movingTime  Int           // seconds
  elapsedTime Int           // seconds
  
  // Pace/Speed
  averageSpeed    Float?    // m/s
  maxSpeed        Float?    // m/s
  
  // Heart Rate
  averageHr       Float?
  maxHr           Int?
  hasHeartrate    Boolean   @default(false)
  
  // Elevation
  totalElevation  Float?    // meters gained
  elevHigh        Float?
  elevLow         Float?
  
  // Calculated metrics
  trimp           Float?    // HR-based training impulse
  runningTss      Float?    // Running-specific stress (null for non-runs)
  estimatedVdot   Float?    // VDOT from this activity if race effort
  
  // HR Zone breakdown (in seconds)
  hrZone1Time     Int?
  hrZone2Time     Int?
  hrZone3Time     Int?
  hrZone4Time     Int?
  hrZone5Time     Int?
  
  // Raw Strava response
  rawJson         Json?
  
  // Relations
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([userId, startDate])
  @@index([type])
}

enum ActivityType {
  RUN
  VIRTUAL_RIDE
  RIDE
  WALK
  HIKE
  SWIM
  WORKOUT
  OTHER
}

// ============================================
// Goals & Training Plans
// ============================================

model Goal {
  id          String    @id @default(cuid())
  userId      String
  
  // Race details
  name        String
  raceType    RaceType
  raceDate    DateTime
  
  // Target
  targetTime  Int?      // seconds (optional, can just be "finish")
  
  // Current predictions based on VDOT
  currentVdot       Float?
  predictedTime     Int?      // seconds
  
  // Training plan settings
  weeklyMileageGoal Float?    // km per week at peak
  planWeeks         Int       @default(12)
  daysPerWeek       Int       @default(4)
  includeCrossTraining Boolean @default(false)
  
  // Status
  isActive    Boolean   @default(true)
  completedAt DateTime?
  actualTime  Int?      // Actual finish time in seconds
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts    Workout[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([userId, isActive])
}

enum RaceType {
  FIVE_K
  TEN_K
  HALF_MARATHON
  MARATHON
}

model Workout {
  id          String    @id @default(cuid())
  goalId      String
  
  // Scheduling
  scheduledDate DateTime
  
  // Workout details
  workoutType   WorkoutType
  description   String
  
  // Targets
  targetDistance  Float?    // meters
  targetDuration  Int?      // seconds
  targetPace      Float?    // sec/km
  targetHrZone    Int?      // 1-5
  
  // Completion
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  linkedActivityId String?  // Link to actual activity
  
  // Relations
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@index([goalId, scheduledDate])
}

enum WorkoutType {
  EASY
  LONG_RUN
  TEMPO
  INTERVALS
  REPETITIONS
  RECOVERY
  RACE
  REST
  CROSS_TRAIN
  RIDE
  SWIM
  STRENGTH
  OTHER
}
