<?xml version="1.0" encoding="utf-8"?>
<!-- Backup rules for Android 12+ (API 31+), referenced by
     android:dataExtractionRules in the manifest.

     Policy (Decision U8 / P0-6):
     1. AuthStore (data/net/AuthStore.kt) persists mobile access and refresh
        JWTs to files/datastore/runflow_auth.preferences_pb via preferencesDataStore.
        The refresh token is a long-lived credential and must NEVER leave the device
        via cloud backup or device-to-device transfer.
     2. Cloud backup: Unencrypted SQLite database (Room activities, workouts, profile)
        is EXCLUDED from Google Drive / cloud backup for user privacy.
     3. Device transfer: Device-to-device cable / direct Wi-Fi migration ALLOWS the
        database so an athlete transferring to a new phone preserves their local
        training database, offline plans, and history seamlessly. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/runflow_auth.preferences_pb" />
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/runflow_auth.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
