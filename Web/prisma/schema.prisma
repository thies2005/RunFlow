// Database schema for RunFlow
// Stores Strava activities, race goals, and training metrics

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?
  isAdmin       Boolean   @default(false)

  // Email/Password Authentication
  passwordHash String? // bcrypt hashed password for email auth users
  authMethod   String  @default("strava") // "strava" | "email" - primary auth method

  // Strava OAuth tokens
  stravaId           String?   @unique
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpiry  DateTime?

  // Athlete profile for calculations
  sex       Sex       @default(MALE)
  birthDate DateTime?
  hrMax     Int? // Maximum heart rate
  hrRest    Int? // Resting heart rate
  weight    Float? // kg
  height    Float? // cm

  // HR Zone thresholds (% of hrMax or absolute if thresholdHr is set)
  thresholdHeartRate Int? // LTHR
  thresholdPace      Int? // seconds/km (Threshold Pace)

  hrZone1Max Int @default(130)
  hrZone2Max Int @default(148)
  hrZone3Max Int @default(160)
  hrZone4Max Int @default(170)
  hrZone5Max Int @default(178)
  hrZone6Max Int @default(187)
  // Zone 7 is > Zone 6

  // VO2max correction based on reference race
  vdotCorrectionFactor  Float     @default(1.0)
  vdotReferenceRaceDate DateTime?
  vdotReferenceRaceTime Int? // seconds
  vdotReferenceRaceType String? // "5K", "10K", "HALF", "MARATHON"

  // Marathon Shape settings
  includeCrossTraining Boolean @default(true) // Include cross-training in marathon shape

  // Display preferences
  useImperial Boolean @default(false) // true = miles, false = kilometers

  // Sync status
  lastSyncAt     DateTime?
  syncInProgress Boolean   @default(false)

  // Relations
  accounts   Account[]
  sessions   Session[]
  activities Activity[]
  goals      Goal[]
  apiKey     ApiKey?
  aiSettings UserAiSettings?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  DailyFitness  DailyFitness[]
  notifications Notification[]
  chatMessages  ChatMessage[]
  chatSessions  ChatSession[]
  usageHistory  AiUsageHistory[]
  
  // Health Tracking
  healthTrackingEnabled Boolean @default(false)
  supplements         Supplement[]
  supplementStacks    SupplementStack[]
  dailyHealthLogs     DailyHealthLog[]
  nutritionLogs       NutritionLog[]
  nutritionTarget     UserNutritionTarget?
  savedMeals          SavedMeal[]
  pushSubscriptions   PushSubscription[]
  reminderSettings    ReminderSettings?
  consents            UserConsent[]
}

// ============================================
// Consent Management Log
// ============================================
model UserConsent {
  id            String   @id @default(cuid())
  userId        String
  consentType   String   // 'TERMS' | 'PRIVACY' | 'HEALTH_DATA' | 'AGE_REQUIREMENT'
  action        String   // 'GRANTED' | 'WITHDRAWN'
  policyVersion String?  // e.g., "2026-02-25"
  ipAddress     String?  // Hashed for audit purposes
  userAgent     String?  // Browser/device info
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

// ============================================
// Admin Audit Trail
// ============================================
model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUser   String   // The internal admin identifier
  action      String   // e.g., 'VIEW_USERS', 'DELETE_USER', 'MODIFY_SETTINGS'
  targetType  String?  // e.g., 'USER', 'BACKUP'
  targetId    String?  // The ID of the affected user or resource
  details     String?  // Additional context in JSON format
  ipAddress   String?  
  userAgent   String?  
  createdAt   DateTime @default(now())

  @@index([adminUser])
  @@index([createdAt])
  @@index([action])
}

// ============================================
// AI Coach Settings
// ============================================

// Global AI settings (admin-controlled singleton)
model GlobalAiSettings {
  id String @id @default("singleton")

  // Default LLM configuration (OpenAI-compatible)
  defaultBaseUrl String  @default("https://api.openai.com/v1")
  defaultApiKey  String? // Encrypted admin API key
  defaultModel   String  @default("gpt-4o-mini")

  // Usage Tiers (0 = BYOK only, 1-3 = customizable limits)
  tier1Name         String @default("Basic")
  tier1DailyLimit   Int    @default(10)
  tier1MonthlyLimit Int    @default(100)

  tier2Name         String @default("Standard")
  tier2DailyLimit   Int    @default(25)
  tier2MonthlyLimit Int    @default(300)

  tier3Name         String @default("Premium")
  tier3DailyLimit   Int    @default(50)
  tier3MonthlyLimit Int    @default(500)

  // Token Limits for Tiers
  tier1DailyTokenLimit   Int @default(50000)
  tier1MonthlyTokenLimit Int @default(500000)

  tier2DailyTokenLimit   Int @default(100000)
  tier2MonthlyTokenLimit Int @default(1000000)

  tier3DailyTokenLimit   Int @default(200000)
  tier3MonthlyTokenLimit Int @default(2000000)

  // CalorieSnap (AI Food Scan) Config
  calorieSnapModel      String @default("gemini-1.5-flash")
  tier1CalorieSnapLimit Int    @default(1) // Basic: 1 scan/day
  tier2CalorieSnapLimit Int    @default(3) // Standard: 3 scans/day
  tier3CalorieSnapLimit Int    @default(6) // Premium: 6 scans/day

  // Legacy limits (deprecated, use tiers instead)
  dailyMessageLimit   Int @default(50)
  monthlyMessageLimit Int @default(500)

  // System prompt (base coach persona)
  systemPrompt String @default("You are a knowledgeable and encouraging running coach. Analyze the athlete's data and provide personalized, actionable advice. Be specific when referencing their metrics and progress. Keep responses concise but insightful.")

  // Active Provider Configuration
  activeProviderId String?
  activeProvider   AiProvider? @relation("ActiveProvider", fields: [activeProviderId], references: [id])

  // Fallback Provider Configuration
  fallbackProviderId String?
  fallbackProvider   AiProvider? @relation("FallbackProvider", fields: [fallbackProviderId], references: [id])

  updatedAt DateTime @updatedAt
}

// AI Providers (OpenAI, Anthropic, Google, etc.)
model AiProvider {
  id       String   @id @default(cuid())
  name     String // e.g. "OpenAI", "Anthropic"
  slug     String   @unique // e.g. "openai", "anthropic" ("google" for Gemini)
  type     String // "openai" | "anthropic" | "google"
  baseUrl  String
  apiKey   String // Encrypted
  models   String[] // List of model IDs e.g. ["gpt-4", "claude-3-opus"]
  isActive Boolean  @default(true)

  // Usage Tracking
  monthlyInputTokensUsed  Int      @default(0)
  monthlyOutputTokensUsed Int      @default(0)
  monthlyTokenLimit       BigInt?  // Null = unlimited. Using BigInt for high limits.
  lastUsageReset          DateTime @default(now())

  activeInSettings    GlobalAiSettings[] @relation("ActiveProvider")
  fallbackInSettings  GlobalAiSettings[] @relation("FallbackProvider")
  dailyUsage     AiDailyTokenUsage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-user AI configuration
model UserAiSettings {
  id     String @id @default(cuid())
  userId String @unique

  // Feature activation - controlled by usageTier or BYOK
  adminAllowed Boolean @default(false)
  aiEnabled    Boolean @default(false)

  // Usage tier: "none" = BYOK only, "tier1", "tier2", "tier3" = admin-assigned
  usageTier String @default("none")

  // BYOK - User's own OpenAI-compatible endpoint
  customBaseUrl String? // e.g., "https://api.anthropic.com/v1" or local
  customApiKey  String? // Encrypted
  customModel   String?

  // Activity feedback settings
  feedbackMode String @default("on_demand") // "off" | "on_demand" | "auto" | "both"

  // Granular data access permissions (all default OFF)
  accessFitnessMetrics  Boolean @default(false) // CTL, ATL, TSB
  
  accessActivityHistory Boolean @default(false) // Runs, times, distances
  accessHeartRateData   Boolean @default(false) // HR zones, avg/max HR
  accessGoals           Boolean @default(false) // Race goals & targets
  accessTrainingPlan    Boolean @default(false) // Scheduled workouts
  accessPerformance     Boolean @default(false) // VDOT, predictions
  accessBiometrics      Boolean @default(false) // Weight, height, age
  accessAllActivities   Boolean @default(false) // Allow AI to search entire history (lazy load)

  // Custom prompt additions (appended to global prompt)
  customPromptAddition String?

  // Usage tracking
  messagesUsedToday     Int @default(0)
  messagesUsedThisMonth Int @default(0)

  // Token tracking
  inputTokensUsedToday      Int @default(0)
  outputTokensUsedToday     Int @default(0)
  inputTokensUsedThisMonth  Int @default(0)
  outputTokensUsedThisMonth Int @default(0)

  lastUsageReset DateTime @default(now())

  // CalorieSnap (AI Food Scan) usage tracking
  calorieSnapsUsedToday Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Cached AI feedback for activities
model ActivityAiFeedback {
  id         String @id @default(cuid())
  activityId String @unique

  // Three feedback fields
  plannedComparison String? @db.Text // vs scheduled workout
  progressAnalysis  String? @db.Text // weekly/monthly progress
  goalTrajectory    String? @db.Text // race goal alignment

  generatedAt DateTime @default(now())

  @@index([activityId])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthCode {
  id        String       @id @default(cuid())
  email     String
  code      String
  type      AuthCodeType
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([email, type])
}

enum AuthCodeType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

// ============================================
// Activities
// ============================================

model Activity {
  id       String @id @default(cuid())
  userId   String
  stravaId BigInt @unique

  // Activity type
  type      ActivityType
  sportType String? // Strava's sport_type field

  // Basic metrics
  name        String
  description String?
  startDate   DateTime
  timezone    String?

  // Distance & Duration
  distance    Float // meters
  movingTime  Int // seconds
  elapsedTime Int // seconds

  // Pace/Speed
  averageSpeed       Float? // m/s
  maxSpeed           Float? // m/s
  gradeAdjustedSpeed Float? // m/s (GAP)

  // Heart Rate
  averageHr      Float?
  maxHr          Int?
  averageCadence Float? // steps per minute (spm)
  hasHeartrate   Boolean @default(false)

  // Elevation
  totalElevation Float? // meters gained
  elevHigh       Float?
  elevLow        Float?
  calories       Float?

  // Calculated metrics
  trimp         Float? // HR-based training impulse
  runningTss    Float? // Running-specific stress (null for non-runs)
  estimatedVdot Float? // VDOT from this activity if race effort

  // HR Zone breakdown (in seconds)
  hrZone1Time Int?
  hrZone2Time Int?
  hrZone3Time Int?
  hrZone4Time Int?
  hrZone5Time Int?
  hrZone6Time Int?
  hrZone7Time Int?

  // Raw Strava response
  rawJson Json?
  streams Json? // Stored streams (time, hr, distance, altitude, velocity_smooth)

  // Training Classification
  trainingType WorkoutType? // Auto-tagged or manual override

  // Relations
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  linkedWorkouts Workout[]
  laps           Lap[]
  splits         Split[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  ChatMessage ChatMessage[]

  @@index([userId, startDate])
  @@index([type])
  @@index([userId, type, startDate]) // For filtering by type within date range
  @@index([userId, hasHeartrate]) // For HR-based metrics queries
  @@index([userId, estimatedVdot]) // For VDOT trend analytics
  @@index([stravaId])
}

model Lap {
  id         String    @id @default(cuid())
  activityId String
  index      Int
  startDate  DateTime
  endDate    DateTime
  distance   Float?
  movingTime Int?
  totalElevationGain Float?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model Split {
  id         String    @id @default(cuid())
  activityId String
  index      Int
  distance   Float?
  movingTime Int?
  averageSpeed Float?
  averageHr    Float?
  totalElevationGain Float?

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

enum ActivityType {
  RUN
  VIRTUAL_RIDE
  RIDE
  WALK
  HIKE
  SWIM
  WORKOUT
  OTHER
}

// ============================================
// Metrics Caching
// ============================================

model DailyFitness {
  id     String   @id @default(cuid())
  userId String
  date   DateTime

  // Metrics
  ctl        Float @default(0)
  atl        Float @default(0)
  tsb        Float @default(0)
  ctlRunning Float @default(0)

  // Daily load (source data)
  trimp      Float @default(0)
  runningTss Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ============================================
// Health Tracking (Supplements, Steps, Weight)
// ============================================

model SupplementStack {
  id        String   @id @default(cuid())
  userId    String
  name      String
  timeOfDay String?  // Optional, morning/noon/evening grouping
  isActive  Boolean  @default(true)
  order     Int      @default(0)

  supplements Supplement[]
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, timeOfDay])
}

model Supplement {
  id        String   @id @default(cuid())
  userId    String
  name      String
  amount    Float
  unit      String           // e.g. "mg", "g", "IU", "capsules", "drops"
  timeOfDay String           // "MORNING" | "NOON" | "EVENING"
  daysOfWeek Json            // array of ints [0,1,2,3,4,5,6] (0=Sunday)
  order     Int      @default(0)
  isActive  Boolean  @default(true)

  stackId   String?
  stack     SupplementStack? @relation(fields: [stackId], references: [id], onDelete: SetNull)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs      SupplementLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, timeOfDay])
  @@index([stackId])
}

model SupplementLog {
  id           String   @id @default(cuid())
  supplementId String
  date         DateTime @db.Date // Midnight UTC for the logged day
  taken        Boolean  @default(false)

  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplementId, date])
}

model DailyHealthLog {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date // Midnight UTC for the logged day
  steps     Int?
  weight    Float?   // kg

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt // useful for checking "last synced"

  @@unique([userId, date])
  @@index([userId, date])
}

// ============================================
// Goals & Training Plans
// ============================================

model Goal {
  id     String @id @default(cuid())
  userId String

  // Race details
  name     String
  raceType RaceType
  raceDate DateTime

  // Target
  targetTime Int? // seconds (optional, can just be "finish")

  // Current predictions based on VDOT
  currentVdot         Float?
  predictedTime       Int? // seconds
  marathonShapeFactor Float  @default(1.0) // Correction Multiplier

  // Training plan settings
  weeklyMileageGoal Float? // km per week at peak
  planWeeks         Int    @default(12)
  runsPerWeek       Int    @default(4)
  ridesPerWeek      Int    @default(0)
  strengthPerWeek   Int    @default(0)
  swimsPerWeek      Int    @default(0)

  // Phase Customization
  taperWeeks Int @default(2)
  peakWeeks  Int @default(4)
  buildWeeks Int @default(4)

  // Preferred Training Days (0=Sunday, 1=Monday, ..., 6=Saturday)
  longRunDay Int  @default(0) // Default Sunday
  workoutDay Int  @default(3) // Default Wednesday
  restDays   Json @default("[1, 5]") // Default Monday & Friday as rest days

  // Status
  isActive    Boolean   @default(true)
  completedAt DateTime?

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

enum RaceType {
  FIVE_K
  TEN_K
  HALF_MARATHON
  MARATHON
}

model Workout {
  id     String @id @default(cuid())
  goalId String

  // Scheduling
  scheduledDate DateTime

  // Workout details
  workoutType WorkoutType
  description String
  phase       PlanPhase   @default(BASE)
  order       Int         @default(0)
  notes       String?

  // Targets
  targetDistance Float? // meters
  targetDuration Int? // seconds
  targetPace     Float? // sec/km
  targetHrZone   Int? // 1-5

  // Completion
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  linkedActivityId String? // Link to actual activity
  linkedActivity   Activity? @relation(fields: [linkedActivityId], references: [id])

  // Relations
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId, scheduledDate])
  @@index([goalId, isCompleted])
  @@index([linkedActivityId])
}

enum WorkoutType {
  EASY
  LONG_RUN
  TEMPO
  INTERVALS
  REPETITIONS
  RECOVERY
  RACE
  REST
  CROSS_TRAIN
  RIDE
  SWIM
  STRENGTH
  OTHER
}

enum PlanPhase {
  BASE
  BUILD
  PEAK
  TAPER
  RACE_WEEK
  RECOVERY
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String   // Public key
  auth      String   // Auth secret

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model ReminderSettings {
  id     String @id @default(cuid())
  userId String @unique

  // Supplement reminders (times as "HH:MM" strings)
  supplementMorningEnabled Boolean @default(false)
  supplementMorningTime    String  @default("08:00")
  supplementNoonEnabled    Boolean @default(false)
  supplementNoonTime       String  @default("12:00")
  supplementEveningEnabled Boolean @default(false)
  supplementEveningTime    String  @default("20:00")

  // Weight reminder
  weightReminderEnabled    Boolean @default(false)
  weightReminderTime       String  @default("07:00")

  // Food tracking reminders
  foodBreakfastEnabled     Boolean @default(false)
  foodBreakfastTime        String  @default("09:00")
  foodLunchEnabled         Boolean @default(false)
  foodLunchTime            String  @default("13:00")
  foodDinnerEnabled        Boolean @default(false)
  foodDinnerTime           String  @default("19:00")

  // Workout reminders (auto from scheduled workouts)
  workoutReminderEnabled   Boolean @default(false)
  workoutReminderMinutes   Int     @default(60) // minutes before scheduled time

  // User timezone for correct scheduling
  timezone                 String  @default("UTC")

  // Track last sent times to avoid duplicates
  lastSupplementMorningSent DateTime?
  lastSupplementNoonSent    DateTime?
  lastSupplementEveningSent DateTime?
  lastWeightSent            DateTime?
  lastFoodBreakfastSent     DateTime?
  lastFoodLunchSent         DateTime?
  lastFoodDinnerSent        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================
// API Keys for External Access
// ============================================

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @unique // One key per user
  keyHash    String // SHA-256 hash of the API key
  keyPrefix  String // First 8 chars for display (e.g., "rf_abc12...")
  name       String    @default("My API Key")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime? // Optional expiration

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
}

// ============================================
// Chat History
// ============================================

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // "user" | "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())

  // Optional: link to activity if context-specific
  activityId String?
  activity   Activity? @relation(fields: [activityId], references: [id])

  // Link to ChatSession
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
}

model ChatSession {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId, updatedAt])
}

// Daily aggregated token usage for analytics
model AiDailyTokenUsage {
  id           String   @id @default(cuid())
  date         DateTime @db.Date // Midnight UTC
  
  inputTokens  Int @default(0)
  outputTokens Int @default(0)
  
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([date, providerId])
  @@index([date])
}

// Granular AI usage history per request
model AiUsageHistory {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  providerId   String?
  model        String?
  
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  timestamp    DateTime @default(now())

  @@index([userId])
  @@index([timestamp])
}

// ============================================
// Nutrition & Food Tracking
// ============================================

model FoodItem {
  id          String         @id @default(cuid())
  name        String
  brand       String?
  barcode     String?        @unique
  calories    Float
  protein     Float
  carbs       Float
  fats        Float
  servingSize String?

  // Micronutrients
  fiber          Float?
  sugar          Float?
  saturatedFat   Float?
  sodium         Float?
  potassium      Float?
  cholesterol    Float?
  calcium        Float?
  iron           Float?

  logs        NutritionLog[]
}

model NutritionLog {
  id         String    @id @default(cuid())
  userId     String
  date       String    // e.g., "yyyy-MM-dd"
  mealType   String?   // e.g., "BREAKFAST", "LUNCH", "DINNER", "SNACK"
  quantity   Float     // e.g., 1.5 (for 1.5 servings)

  // Snapshot of macros at the time of logging
  calories   Float
  protein    Float
  carbs      Float
  fats       Float

  // Snapshot of micronutrients at the time of logging
  fiber          Float?
  sugar          Float?
  saturatedFat   Float?
  sodium         Float?
  potassium      Float?
  cholesterol    Float?
  calcium        Float?
  iron           Float?

  foodItemId String
  foodItem   FoodItem  @relation(fields: [foodItemId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())
}

model UserNutritionTarget {
  id             String   @id @default(cuid())
  userId         String   @unique
  dailyCalories  Int      @default(2000)
  proteinPercent Float    @default(30)  // 30%
  carbsPercent   Float    @default(40)  // 40%
  fatsPercent    Float    @default(30)  // 30%

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
}

// ============================================
// Saved Meals (AI Food Scanner Library)
// ============================================

model SavedMeal {
  id            String          @id @default(cuid())
  userId        String
  name          String          // e.g. "Greek Salad with Olive Oil"
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFats     Float

  items         SavedMealItem[]
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model SavedMealItem {
  id             String    @id @default(cuid())
  savedMealId    String
  name           String    // e.g. "Olive Oil"
  estimatedGrams Float     // e.g. 27
  calories       Float
  protein        Float
  carbs          Float
  fats           Float

  savedMeal      SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
}

