# Database
DATABASE_URL=postgresql://user:password@db:5432/runflow

# PostgreSQL Credentials
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=runflow

# NextAuth.js
NEXTAUTH_SECRET=generate-a-strong-secret-key-for-prod
NEXTAUTH_URL=http://localhost:3000

# Strava API
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=

# Encryption
ENCRYPTION_KEY=generate-32-byte-base64-key-for-prod

# Mobile App JWT
JWT_SECRET=generate-strong-jwt-secret-for-prod
JWT_ACCESS_EXPIRY=24h
JWT_REFRESH_EXPIRY=30d

# Admin
ADMIN_USERNAME=admin-user
ADMIN_PASSWORD=secure-password
ADMIN_PASSWORD_HASH=

# Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=generate-a-random-secret-for-cron

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# SMTP Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@example.com

# Sentry
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_APP_VERSION=

# FatSecret API
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Redis (for rate limiting, caching, and distributed locks)
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
