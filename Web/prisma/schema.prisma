model ApiRouteMetric {
  id            String   @id @default(cuid())
  routePath     String
  method        String
  statusCode    Int
  responseTime  Int
  cpuUsage      Float?
  memoryUsage   Float?
  requestSize   Int?
  responseSize  Int?
  timestamp     DateTime @default(now())
  userId        String?
  userAgent     String?
  ipAddress     String?

  @@index([routePath, timestamp])
  @@index([timestamp])
  @@index([userId])
}

model ErrorLog {
  id          String   @id @default(cuid())
  routePath   String
  method      String
  errorMessage String
  stackTrace  String?
  userId      String?
  userAgent   String?
  timestamp   DateTime @default(now())
  resolved    Boolean  @default(false)
  count       Int      @default(1)
  fingerprint String?

  @@index([timestamp])
  @@index([routePath])
  @@index([errorMessage])
  @@index([fingerprint])
  @@index([resolved])
}

model PerformanceSummary {
  id              String   @id @default(cuid())
  routePath       String
  method          String
  timeRange       String
  timestamp       DateTime @default(now())

  requestCount    Int
  errorCount      Int
  avgResponseTime Float
  p50ResponseTime Float
  p95ResponseTime Float
  p99ResponseTime Float
  avgCpuUsage     Float
  avgMemoryUsage  Float

  @@unique([routePath, method, timeRange, timestamp])
  @@index([routePath, timeRange])
  @@index([timestamp])
}

model SessionReplay {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String
  events      Json
  routePath   String?
  timestamp   DateTime @default(now())
  duration    Int

  @@index([userId, timestamp])
  @@index([timestamp])
  @@index([sessionId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String
  platform  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@index([userId])
}

model Release {
  id          String   @id @default(cuid())
  version     String   @unique
  deployedAt  DateTime @default(now())
  deployedBy  String?
  commitHash  String?
  notes       String?

  @@index([deployedAt])
}

model DailyReadinessRecord {
  id              String    @id @default(cuid())
  userId          String
  date            DateTime  @map("_date")
  compositeScore  Float     @default(0)
  state           String    @default("unavailable")
  confidence      String    @default("unavailable")
  componentScores Json      @default("[]")
  reasons         Json      @default("[]")
  rhrJson         Json?
  sleepJson       Json?
  loadJson        Json?
  subjectiveJson  Json?
  overrideJson    Json?
  computedAt      DateTime?
  syncedAt        DateTime?
  maxHr           Int?
  restingHr       Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("daily_readiness_records")
}

model ReadinessBaseline {
  id                String   @id @default(cuid())
  userId            String
  rhrMedian30Day    Float?
  sleepAverage28Day Float?
  lastUpdated       DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("readiness_baselines")
}

model AdaptedWorkout {
  id                     String    @id @default(cuid())
  userId                 String
  originalWorkoutId      String
  date                   DateTime
  originalType           String
  adaptedType            String
  adaptationType         String
  originalTargetDistance  Float     @default(0)
  adaptedTargetDistance   Float?
  originalTargetDuration Int       @default(0)
  adaptedTargetDuration  Int?
  originalTargetPace     Float     @default(0)
  adaptedTargetPace      Float?
  reason                 String    @default("")
  readinessScore         Float     @default(0)
  readinessState         String    @default("unavailable")
  isAccepted             Boolean   @default(false)
  createdAt              DateTime  @default(now())
  syncedAt               DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, originalWorkoutId])
  @@map("adapted_workouts")
}

model WeeklyReconciliationRecord {
  id                    String    @id @default(cuid())
  userId                String
  weekStartDate         DateTime
  plannedLoad           Float     @default(0)
  actualLoad            Float     @default(0)
  adaptedLoad           Float     @default(0)
  deficitPercent        Float     @default(0)
  surplusPercent        Float     @default(0)
  adjustmentDescription String?
  isApplied             Boolean   @default(false)
  raceWeeksRemaining    Int?
  requiresReview        Boolean   @default(false)
  createdAt             DateTime  @default(now())
  syncedAt              DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekStartDate])
  @@map("weekly_reconciliation_records")
}

model PlanSnapshot {
  id          String   @id @default(cuid())
  goalId      String
  snapshot    Json
  description String?
  operation   String?
  createdAt   DateTime @default(now())
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
}

model WeekTemplate {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  days        Json
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model IntervalProgression {
  id          String      @id @default(cuid())
  goalId      String
  name        String
  workoutType WorkoutType
  startWeek   Int
  endWeek     Int
  weeks       Json
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  goal        Goal        @relation(fields: [goalId], references: [id], onDelete: Cascade)
  workouts    Workout[]

  @@index([goalId])
}

model AiPlanAnalysis {
  id              String   @id @default(cuid())
  goalId          String   @unique
  overallScore    Float?
  overallSummary  String?  @db.Text
  weekAnalyses    Json?
  riskFlags       Json?
  raceReadiness   Json?
  suggestions     Json?
  modelUsed       String?
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  generatedAt     DateTime @default(now())
  goal            Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model PlanPaceProfile {
  id          String   @id @default(cuid())
  goalId      String   @unique
  baseVdot    Float
  profiles    Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  goal        Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
}

model GuidedPlanSession {
  id                  String   @id @default(cuid())
  goalId              String?
  userId              String
  currentStep         String
  responses           Json
  aiRecommendation    Json?
  isComplete          Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  goal                Goal?    @relation(fields: [goalId], references: [id])
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([goalId])
}
