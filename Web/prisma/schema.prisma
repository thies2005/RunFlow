generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String               @id @default(cuid())
  email                 String?              @unique
  name                  String?
  image                 String?
  emailVerified         DateTime?
  passwordHash          String?
  authMethod            String               @default("strava")
  stravaId              String?              @unique
  stravaAccessToken     String?
  stravaRefreshToken    String?
  stravaTokenExpiry     DateTime?
  sex                   Sex                  @default(MALE)
  birthDate             DateTime?
  hrMax                 Int?
  hrRest                Int?
  weight                Float?
  height                Float?
  thresholdHeartRate    Int?
  thresholdPace         Int?
  hrZone1Max            Int                  @default(130)
  hrZone2Max            Int                  @default(148)
  hrZone3Max            Int                  @default(160)
  hrZone4Max            Int                  @default(170)
  hrZone5Max            Int                  @default(178)
  hrZone6Max            Int                  @default(187)
  vdotCorrectionFactor  Float                @default(1.0)
  vdotReferenceRaceDate DateTime?
  vdotReferenceRaceTime Int?
  vdotReferenceRaceType String?
  autoRevolvingVo2max      Float?
  autoRevolvingCalculatedAt DateTime?
  includeCrossTraining  Boolean              @default(true)
  useImperial           Boolean              @default(false)
  lastSyncAt            DateTime?
  syncInProgress        Boolean              @default(false)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  healthTrackingEnabled Boolean              @default(false)
  isAdmin               Boolean              @default(false)
  accounts              Account[]
  activities            Activity[]
  usageHistory          AiUsageHistory[]
  apiKey                ApiKey?
  chatMessages          ChatMessage[]
  chatSessions          ChatSession[]
  DailyFitness          DailyFitness[]
  dailyHealthLogs       DailyHealthLog[]
  goals                 Goal[]
  notifications         Notification[]
  nutritionLogs         NutritionLog[]
  pushSubscriptions     PushSubscription[]
  reminderSettings      ReminderSettings?
  savedMeals            SavedMeal[]
  sessions              Session[]
  supplements           Supplement[]
  supplementStacks      SupplementStack[]
  aiSettings            UserAiSettings?
  feedbackJobs          FeedbackJob[]
  consents              UserConsent[]
  nutritionTarget       UserNutritionTarget?
  bodyMeasurements      BodyMeasurement[]
  fastingSessions       FastingSession[]
  healthInsights        HealthInsight[]
  deviceTokens          DeviceToken[]
  dailyReadinessRecords DailyReadinessRecord[]
  readinessBaselines    ReadinessBaseline[]
  adaptedWorkouts       AdaptedWorkout[]
  weeklyReconciliationRecords WeeklyReconciliationRecord[]
  weekTemplates             WeekTemplate[]
  guidedPlanSessions        GuidedPlanSession[]
}

model UserConsent {
  id            String   @id @default(cuid())
  userId        String
  consentType   String
  action        String
  policyVersion String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consentType])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminUser  String
  action     String
  targetType String?
  targetId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminUser])
  @@index([createdAt])
  @@index([action])
}

model GlobalAiSettings {
  id                     String      @id @default("singleton")
  defaultBaseUrl         String      @default("https://api.openai.com/v1")
  defaultApiKey          String?
  defaultModel           String      @default("gpt-4o-mini")
  tier1Name              String      @default("Basic")
  tier1DailyLimit        Int         @default(10)
  tier1MonthlyLimit      Int         @default(100)
  tier2Name              String      @default("Standard")
  tier2DailyLimit        Int         @default(25)
  tier2MonthlyLimit      Int         @default(300)
  tier3Name              String      @default("Premium")
  tier3DailyLimit        Int         @default(50)
  tier3MonthlyLimit      Int         @default(500)
  dailyMessageLimit      Int         @default(50)
  monthlyMessageLimit    Int         @default(500)
  systemPrompt           String      @default("You are a knowledgeable and encouraging running coach. Analyze the athlete's data and provide personalized, actionable advice. Be specific when referencing their metrics and progress. Keep responses concise but insightful.")
  activeProviderId       String?
  updatedAt              DateTime    @updatedAt
  tier1DailyTokenLimit   Int         @default(50000)
  tier1MonthlyTokenLimit Int         @default(500000)
  tier2DailyTokenLimit   Int         @default(100000)
  tier2MonthlyTokenLimit Int         @default(1000000)
  tier3DailyTokenLimit   Int         @default(200000)
  tier3MonthlyTokenLimit Int         @default(2000000)
  fallbackProviderId     String?
  calorieSnapModel       String      @default("gemini-1.5-flash")
  tier1CalorieSnapLimit  Int         @default(1)
  tier2CalorieSnapLimit  Int         @default(3)
  tier3CalorieSnapLimit  Int         @default(6)
  // Non-realtime model quotas (per-day per-user)
  mealSuggestModel           String  @default("gemini-1.5-flash")
  tier1MealSuggestLimit      Int     @default(3)
  tier2MealSuggestLimit      Int     @default(10)
  tier3MealSuggestLimit      Int     @default(25)
  activityFeedbackModel      String  @default("gemini-1.5-flash")
  tier1ActivityFeedbackLimit Int     @default(5)
  tier2ActivityFeedbackLimit Int     @default(15)
  tier3ActivityFeedbackLimit Int     @default(50)
  activeProvider         AiProvider? @relation("ActiveProvider", fields: [activeProviderId], references: [id])
  fallbackProvider       AiProvider? @relation("FallbackProvider", fields: [fallbackProviderId], references: [id])
  planBuilderProviderId  String?
  planBuilderModel       String      @default("gpt-4o")
  planMaxTokensPerAnalysis Int       @default(8000)
  planBuilderProvider    AiProvider? @relation("PlanBuilderProvider", fields: [planBuilderProviderId], references: [id])
}

model AiProvider {
  id                      String              @id @default(cuid())
  name                    String
  slug                    String              @unique
  type                    String
  baseUrl                 String
  apiKey                  String
  models                  String[]
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  lastUsageReset          DateTime            @default(now())
  monthlyInputTokensUsed  Int                 @default(0)
  monthlyOutputTokensUsed Int                 @default(0)
  monthlyTokenLimit       BigInt?
  dailyUsage              AiDailyTokenUsage[]
  activeInSettings        GlobalAiSettings[]  @relation("ActiveProvider")
  fallbackInSettings      GlobalAiSettings[]  @relation("FallbackProvider")
  planBuilderInSettings   GlobalAiSettings[]  @relation("PlanBuilderProvider")
}

model UserAiSettings {
  id                        String   @id @default(cuid())
  userId                    String   @unique
  adminAllowed              Boolean  @default(false)
  aiEnabled                 Boolean  @default(false)
  usageTier                 String   @default("none")
  customBaseUrl             String?
  customApiKey              String?
  customModel               String?
  feedbackMode              String   @default("on_demand")
  accessFitnessMetrics      Boolean  @default(false)
  accessActivityHistory     Boolean  @default(false)
  accessHeartRateData       Boolean  @default(false)
  accessGoals               Boolean  @default(false)
  accessTrainingPlan        Boolean  @default(false)
  accessPerformance         Boolean  @default(false)
  accessBiometrics          Boolean  @default(false)
  customPromptAddition      String?
  messagesUsedToday         Int      @default(0)
  messagesUsedThisMonth     Int      @default(0)
  lastUsageReset            DateTime @default(now())
  accessAllActivities       Boolean  @default(false)
  inputTokensUsedThisMonth  Int      @default(0)
  inputTokensUsedToday      Int      @default(0)
  outputTokensUsedThisMonth Int      @default(0)
  outputTokensUsedToday     Int      @default(0)
  calorieSnapsUsedToday     Int      @default(0)
  accessActivityLogs        Boolean  @default(false)
  accessNutritionLogs       Boolean  @default(false)
  // Non-realtime usage tracking
  mealSuggestsUsedToday     Int      @default(0)
  activityFeedbackUsedToday Int      @default(0)
  user                      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityAiFeedback {
  id                String   @id @default(cuid())
  activityId        String   @unique
  plannedComparison String?
  progressAnalysis  String?
  goalTrajectory    String?
  generatedAt       DateTime @default(now())

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

enum FeedbackJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

model FeedbackJob {
  id          String            @id @default(cuid())
  userId      String
  activityId  String            @unique
  status      FeedbackJobStatus @default(PENDING)
  priority    Int               @default(5) // 1=high (manual), 5=normal (auto), 10=backfill
  retryCount  Int               @default(0)
  maxRetries  Int               @default(3)
  nextRunAt   DateTime          @default(now()) // for retry backoff
  errorLog    String?           @db.Text
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([status, nextRunAt])
  @@index([userId, activityId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthCode {
  id        String       @id @default(cuid())
  email     String
  code      String
  type      AuthCodeType
  expiresAt DateTime
  createdAt DateTime     @default(now())

  @@index([email, type])
}

model Activity {
  id                 String        @id @default(cuid())
  userId             String
  stravaId           BigInt        @unique
  type               ActivityType
  sportType          String?
  name               String
  description        String?
  startDate          DateTime
  timezone           String?
  distance           Float
  movingTime         Int
  elapsedTime        Int
  averageSpeed       Float?
  maxSpeed           Float?
  gradeAdjustedSpeed Float?
  averageHr          Float?
  maxHr              Int?
  averageCadence     Float?
  hasHeartrate       Boolean       @default(false)
  totalElevation     Float?
  elevHigh           Float?
  elevLow            Float?
  calories           Float?
  trimp              Float?
  runningTss         Float?
  estimatedVdot      Float?
  hrZone1Time        Int?
  hrZone2Time        Int?
  hrZone3Time        Int?
  hrZone4Time        Int?
  hrZone5Time        Int?
  hrZone6Time        Int?
  hrZone7Time        Int?
  rawJson            Json?
  streams            Json?
  trainingType       WorkoutType?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ChatMessage        ChatMessage[]
  laps               Lap[]
  splits             Split[]
  linkedWorkouts     Workout[]
  raceResults        RaceResult[] @relation("GoalRaceActivity")
  aiFeedback         ActivityAiFeedback?
  feedbackJob        FeedbackJob?

  @@index([userId, startDate])
  @@index([type])
  @@index([userId, type, startDate])
  @@index([userId, hasHeartrate])
  @@index([userId, estimatedVdot])
  @@index([stravaId])
}

model Lap {
  id                 String   @id @default(cuid())
  activityId         String
  index              Int
  startDate          DateTime
  endDate            DateTime
  distance           Float?
  movingTime         Int?
  totalElevationGain Float?
  activity           Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model Split {
  id                 String   @id @default(cuid())
  activityId         String
  index              Int
  distance           Float?
  movingTime         Int?
  averageSpeed       Float?
  averageHr          Float?
  totalElevationGain Float?
  activity           Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId])
}

model DailyFitness {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  ctl        Float    @default(0)
  atl        Float    @default(0)
  tsb        Float    @default(0)
  ctlRunning Float    @default(0)
  trimp      Float    @default(0)
  runningTss Float    @default(0)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model SupplementStack {
  id          String       @id @default(cuid())
  userId      String
  name        String
  timeOfDay   String?
  isActive    Boolean      @default(true)
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  supplements Supplement[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timeOfDay])
}

model Supplement {
  id         String           @id @default(cuid())
  userId     String
  name       String
  amount     Float
  unit       String
  timeOfDay  String
  daysOfWeek Json
  order      Int              @default(0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  stackId    String?
  stack      SupplementStack? @relation(fields: [stackId], references: [id])
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  logs       SupplementLog[]

  @@index([userId, timeOfDay])
  @@index([stackId])
}

model SupplementLog {
  id           String     @id @default(cuid())
  supplementId String
  date         DateTime   @db.Date
  taken        Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  supplement   Supplement @relation(fields: [supplementId], references: [id], onDelete: Cascade)

  @@unique([supplementId, date])
}

model DailyHealthLog {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  steps          Int?
  weight         Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  waterIntake    Int?
  activeCalories Float?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

model Goal {
  id                    String              @id @default(cuid())
  userId                String
  name                  String
  raceType              RaceType?
  raceDate              DateTime?
  planStartDate         DateTime?
  targetTime            Int?
  currentVdot           Float?
  predictedTime         Int?
  marathonShapeFactor   Float               @default(1.0)
  weeklyMileageGoal     Float?
  planWeeks             Int                 @default(12)
  runsPerWeek           Int                 @default(4)
  ridesPerWeek          Int                 @default(0)
  strengthPerWeek       Int                 @default(0)
  swimsPerWeek          Int                 @default(0)
  taperWeeks            Int                 @default(2)
  peakWeeks             Int                 @default(4)
  buildWeeks            Int                 @default(4)
  longRunDay            Int                 @default(0)
  workoutDay            Int                 @default(3)
  swimDay               Int?
  restDays              Json                @default("[1, 5]")
  isActive              Boolean             @default(true)
  completedAt           DateTime?
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  sport                 PlanSport           @default(RUN)
  creationMode          PlanCreationMode    @default(STANDARD_BUILDER)
  customDistanceM       Float?
  customSwimDistM       Float?
  customBikeDistM       Float?
  customRunDistM        Float?
  backyardLoopDistM     Float?
  backyardLoopTimeS     Int?
  targetLaps            Int?
  planSource            String              @default("standard")
  guidanceLevel         String              @default("none")
  parentGoalId          String?
  priority              GoalPriority        @default(PRIMARY)
  trainingFocus         String?
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts              Workout[]
  raceResult            RaceResult?
  parentGoal            Goal?               @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  subGoals              Goal[]              @relation("GoalHierarchy")
  snapshots             PlanSnapshot[]
  intervalProgressions  IntervalProgression[]
  aiAnalysis            AiPlanAnalysis?
  paceProfile           PlanPaceProfile?
  taggedWorkouts        Workout[]           @relation("WorkoutSubGoal")
  guidedPlanSessions    GuidedPlanSession[]

  @@index([userId, isActive])
}

model RaceResult {
  id                 String    @id @default(cuid())
  goalId             String    @unique
  goal               Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  raceActivityId     String?   @unique
  raceActivity       Activity? @relation("GoalRaceActivity", fields: [raceActivityId], references: [id])
  actualTime         Int?
  chipTime           Int?
  placementOverall   Int?
  placementGender    Int?
  placementAgeGroup  Int?
  ageGroup           String?
  totalFinishers     Int?
  notes              String?
  weatherConditions  String?
  feltLike           Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([goalId])
}

model Workout {
  id                      String                @id @default(cuid())
  goalId                  String
  scheduledDate           DateTime
  workoutType             WorkoutType
  description             String
  phase                   PlanPhase             @default(BASE)
  order                   Int                   @default(0)
  notes                   String?
  targetDistance          Float?
  targetDuration          Int?
  targetPace              Float?
  targetHrZone            Int?
  isCompleted             Boolean               @default(false)
  completedAt             DateTime?
  linkedActivityId        String?
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  customName              String?
  color                   String?
  intervalProgressionId   String?
  intervalProgression     IntervalProgression?  @relation(fields: [intervalProgressionId], references: [id])
  structuredSteps         Json?
  groupId                 String?
  subGoalId               String?
  goal                    Goal                  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  linkedActivity          Activity?             @relation(fields: [linkedActivityId], references: [id])
  subGoal                 Goal?                 @relation("WorkoutSubGoal", fields: [subGoalId], references: [id])

  @@index([goalId, scheduledDate])
  @@index([goalId, isCompleted])
  @@index([linkedActivityId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReminderSettings {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  supplementMorningEnabled  Boolean   @default(false)
  supplementMorningTime     String    @default("08:00")
  supplementNoonEnabled     Boolean   @default(false)
  supplementNoonTime        String    @default("12:00")
  supplementEveningEnabled  Boolean   @default(false)
  supplementEveningTime     String    @default("20:00")
  weightReminderEnabled     Boolean   @default(false)
  weightReminderTime        String    @default("07:00")
  foodBreakfastEnabled      Boolean   @default(false)
  foodBreakfastTime         String    @default("09:00")
  foodLunchEnabled          Boolean   @default(false)
  foodLunchTime             String    @default("13:00")
  foodDinnerEnabled         Boolean   @default(false)
  foodDinnerTime            String    @default("19:00")
  workoutReminderEnabled    Boolean   @default(false)
  workoutReminderMinutes    Int       @default(60)
  timezone                  String    @default("UTC")
  lastSupplementMorningSent DateTime?
  lastSupplementNoonSent    DateTime?
  lastSupplementEveningSent DateTime?
  lastWeightSent            DateTime?
  lastFoodBreakfastSent     DateTime?
  lastFoodLunchSent         DateTime?
  lastFoodDinnerSent        DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  user                      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @unique
  keyHash    String
  keyPrefix  String
  name       String    @default("My API Key")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
}

model ChatMessage {
  id         String       @id @default(cuid())
  userId     String
  role       String
  content    String
  createdAt  DateTime     @default(now())
  activityId String?
  sessionId  String?
  activity   Activity?    @relation(fields: [activityId], references: [id])
  session    ChatSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([sessionId])
  @@index([activityId])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New Chat")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model AiDailyTokenUsage {
  id           String     @id @default(cuid())
  date         DateTime   @db.Date
  inputTokens  Int        @default(0)
  outputTokens Int        @default(0)
  providerId   String
  provider     AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([date, providerId])
  @@index([date])
}

model AiUsageHistory {
  id           String   @id @default(cuid())
  userId       String
  providerId   String?
  model        String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  timestamp    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([timestamp])
}

model FoodItem {
  id           String         @id @default(cuid())
  name         String
  brand        String?
  barcode      String?        @unique
  calories     Float
  protein      Float
  carbs        Float
  fats         Float
  servingSize  String?
  fiber        Float?
  sugar        Float?
  saturatedFat Float?
  sodium       Float?
  potassium    Float?
  cholesterol  Float?
  calcium      Float?
  iron         Float?
  logs         NutritionLog[]
}

model NutritionLog {
  id           String   @id @default(cuid())
  userId       String
  date         String
  mealType     String?
  quantity     Float
  calories     Float
  protein      Float
  carbs        Float
  fats         Float
  fiber        Float?
  sugar        Float?
  saturatedFat Float?
  sodium       Float?
  potassium    Float?
  cholesterol  Float?
  calcium      Float?
  iron         Float?
  foodItemId   String
  createdAt    DateTime @default(now())
  foodItem     FoodItem @relation(fields: [foodItemId], references: [id])
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model UserNutritionTarget {
  id                    String   @id @default(cuid())
  userId                String   @unique
  dailyCalories         Int      @default(2000)
  proteinPercent        Float    @default(30)
  carbsPercent          Float    @default(40)
  fatsPercent           Float    @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  exerciseCalorieFactor Float    @default(0.5)
  waterGoalMl           Int      @default(2500)
  waterTrackingEnabled  Boolean  @default(false)
  exerciseCalorieSource String   @default("strava")
  fastingEnabled        Boolean  @default(false)
  fastingGoalHours      Int      @default(16)
  aiInsightProvider     String?  @default("gemini")
  aiInsightApiKey       String?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BodyMeasurement {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime @db.Date
  weight     Float?
  bodyFat    Float?
  muscleMass Float?
  chest      Float?
  waist      Float?
  hips       Float?
  arms       Float?
  thighs     Float?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model FastingSession {
  id        String   @id @default(cuid())
  userId    String
  startTime DateTime @default(now())
  endTime   DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, endTime])
}

model HealthInsight {
  id         String   @id @default(cuid())
  userId     String
  date       DateTime
  rangeStart DateTime
  rangeEnd   DateTime
  content    String   @db.Text
  metrics    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SavedMeal {
  id            String          @id @default(cuid())
  userId        String
  name          String
  totalCalories Float
  totalProtein  Float
  totalCarbs    Float
  totalFats     Float
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         SavedMealItem[]

  @@index([userId])
}

model SavedMealItem {
  id             String    @id @default(cuid())
  savedMealId    String
  name           String
  estimatedGrams Float
  calories       Float
  protein        Float
  carbs          Float
  fats           Float
  savedMeal      SavedMeal @relation(fields: [savedMealId], references: [id], onDelete: Cascade)
}

model OffFoodCache {
