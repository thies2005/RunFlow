// Database schema for RunFlow
// Stores Strava activities, race goals, and training metrics

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// User & Authentication
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  image         String?
  emailVerified DateTime?

  // Email/Password Authentication
  passwordHash  String?   // bcrypt hashed password for email auth users
  authMethod    String    @default("strava") // "strava" | "email" - primary auth method

  // Strava OAuth tokens
  stravaId           String?   @unique
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpiry  DateTime?

  // Athlete profile for calculations
  sex       Sex       @default(MALE)
  birthDate DateTime?
  hrMax     Int? // Maximum heart rate
  hrRest    Int? // Resting heart rate
  weight    Float? // kg
  height    Float? // cm

  // HR Zone thresholds (% of hrMax or absolute if thresholdHr is set)
  thresholdHeartRate Int? // LTHR
  thresholdPace      Int? // seconds/km (Threshold Pace)

  hrZone1Max Int @default(130)
  hrZone2Max Int @default(148)
  hrZone3Max Int @default(160)
  hrZone4Max Int @default(170)
  hrZone5Max Int @default(178)
  hrZone6Max Int @default(187)
  // Zone 7 is > Zone 6

  // VO2max correction based on reference race
  vdotCorrectionFactor  Float     @default(1.0)
  vdotReferenceRaceDate DateTime?
  vdotReferenceRaceTime Int? // seconds
  vdotReferenceRaceType String? // "5K", "10K", "HALF", "MARATHON"

  // Marathon Shape settings
  includeCrossTraining Boolean @default(true) // Include cross-training in marathon shape

  // Display preferences
  useImperial Boolean @default(false) // true = miles, false = kilometers

  // Sync status
  lastSyncAt     DateTime?
  syncInProgress Boolean   @default(false)

  // Relations
  accounts   Account[]
  sessions   Session[]
  activities Activity[]
  goals      Goal[]
  apiKey     ApiKey?
  aiSettings UserAiSettings?

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  DailyFitness DailyFitness[]
  notifications Notification[]
}

// ============================================
// AI Coach Settings
// ============================================

// Global AI settings (admin-controlled singleton)
model GlobalAiSettings {
  id                  String   @id @default("singleton")
  
  // Default LLM configuration (OpenAI-compatible)
  defaultBaseUrl      String   @default("https://api.openai.com/v1")
  defaultApiKey       String?  // Encrypted admin API key
  defaultModel        String   @default("gpt-4o-mini")
  
  // Usage Tiers (0 = BYOK only, 1-3 = customizable limits)
  tier1Name           String   @default("Basic")
  tier1DailyLimit     Int      @default(10)
  tier1MonthlyLimit   Int      @default(100)
  
  tier2Name           String   @default("Standard")
  tier2DailyLimit     Int      @default(25)
  tier2MonthlyLimit   Int      @default(300)
  
  tier3Name           String   @default("Premium")  
  tier3DailyLimit     Int      @default(50)
  tier3MonthlyLimit   Int      @default(500)
  
  // Legacy limits (deprecated, use tiers instead)
  dailyMessageLimit   Int      @default(50)
  monthlyMessageLimit Int      @default(500)
  
  // System prompt (base coach persona)
  systemPrompt        String   @default("You are a knowledgeable and encouraging running coach. Analyze the athlete's data and provide personalized, actionable advice. Be specific when referencing their metrics and progress. Keep responses concise but insightful.")
  
  updatedAt           DateTime @updatedAt
}

// Per-user AI configuration
model UserAiSettings {
  id                    String   @id @default(cuid())
  userId                String   @unique
  
  // Feature activation - controlled by usageTier or BYOK
  aiEnabled             Boolean  @default(false)
  
  // Usage tier: "none" = BYOK only, "tier1", "tier2", "tier3" = admin-assigned
  usageTier             String   @default("none")
  
  // BYOK - User's own OpenAI-compatible endpoint
  customBaseUrl         String?  // e.g., "https://api.anthropic.com/v1" or local
  customApiKey          String?  // Encrypted
  customModel           String?
  
  // Activity feedback settings
  feedbackMode          String   @default("on_demand") // "off" | "on_demand" | "auto" | "both"
  
  // Granular data access permissions (all default OFF)
  accessFitnessMetrics  Boolean  @default(false) // CTL, ATL, TSB
  accessActivityHistory Boolean  @default(false) // Runs, times, distances
  accessHeartRateData   Boolean  @default(false) // HR zones, avg/max HR
  accessGoals           Boolean  @default(false) // Race goals & targets
  accessTrainingPlan    Boolean  @default(false) // Scheduled workouts
  accessPerformance     Boolean  @default(false) // VDOT, predictions
  accessBiometrics      Boolean  @default(false) // Weight, height, age
  
  // Custom prompt additions (appended to global prompt)
  customPromptAddition  String?
  
  // Usage tracking
  messagesUsedToday     Int      @default(0)
  messagesUsedThisMonth Int      @default(0)
  lastUsageReset        DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
}

// Cached AI feedback for activities
model ActivityAiFeedback {
  id                  String   @id @default(cuid())
  activityId          String   @unique
  
  // Three feedback fields
  plannedComparison   String?  @db.Text // vs scheduled workout
  progressAnalysis    String?  @db.Text // weekly/monthly progress
  goalTrajectory      String?  @db.Text // race goal alignment
  
  generatedAt         DateTime @default(now())
  
  @@index([activityId])
}

enum Sex {
  MALE
  FEMALE
  OTHER
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AuthCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  type      AuthCodeType
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, type])
}

enum AuthCodeType {
  VERIFY_EMAIL
  PASSWORD_RESET
}

// ============================================
// Activities
// ============================================

model Activity {
  id       String @id @default(cuid())
  userId   String
  stravaId BigInt @unique

  // Activity type
  type      ActivityType
  sportType String? // Strava's sport_type field

  // Basic metrics
  name        String
  description String?
  startDate   DateTime
  timezone    String?

  // Distance & Duration
  distance    Float // meters
  movingTime  Int // seconds
  elapsedTime Int // seconds

  // Pace/Speed
  averageSpeed       Float? // m/s
  maxSpeed           Float? // m/s
  gradeAdjustedSpeed Float? // m/s (GAP)

  // Heart Rate
  averageHr      Float?
  maxHr          Int?
  averageCadence Float? // steps per minute (spm)
  hasHeartrate   Boolean @default(false)

  // Elevation
  totalElevation Float? // meters gained
  elevHigh       Float?
  elevLow        Float?
  calories       Float?

  // Calculated metrics
  trimp         Float? // HR-based training impulse
  runningTss    Float? // Running-specific stress (null for non-runs)
  estimatedVdot Float? // VDOT from this activity if race effort

  // HR Zone breakdown (in seconds)
  hrZone1Time Int?
  hrZone2Time Int?
  hrZone3Time Int?
  hrZone4Time Int?
  hrZone5Time Int?
  hrZone6Time Int?
  hrZone7Time Int?

  // Raw Strava response
  rawJson Json?
  streams Json? // Stored streams (time, hr, distance, altitude, velocity_smooth)

  // Training Classification
  trainingType WorkoutType? // Auto-tagged or manual override

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
  @@index([type])
  @@index([userId, type, startDate]) // For filtering by type within date range
  @@index([userId, hasHeartrate]) // For HR-based metrics queries
  @@index([userId, estimatedVdot]) // For VDOT trend analytics
}

enum ActivityType {
  RUN
  VIRTUAL_RIDE
  RIDE
  WALK
  HIKE
  SWIM
  WORKOUT
  OTHER
}

// ============================================
// Metrics Caching
// ============================================

model DailyFitness {
  id     String   @id @default(cuid())
  userId String
  date   DateTime

  // Metrics
  ctl        Float @default(0)
  atl        Float @default(0)
  tsb        Float @default(0)
  ctlRunning Float @default(0)

  // Daily load (source data)
  trimp      Float @default(0)
  runningTss Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
}

// ============================================
// Goals & Training Plans
// ============================================

model Goal {
  id     String @id @default(cuid())
  userId String

  // Race details
  name     String
  raceType RaceType
  raceDate DateTime

  // Target
  targetTime Int? // seconds (optional, can just be "finish")

  // Current predictions based on VDOT
  currentVdot         Float?
  predictedTime       Int? // seconds
  marathonShapeFactor Float  @default(1.0) // Correction Multiplier

  // Training plan settings
  weeklyMileageGoal Float? // km per week at peak
  planWeeks         Int    @default(12)
  runsPerWeek       Int    @default(4)
  ridesPerWeek      Int    @default(0)
  strengthPerWeek   Int    @default(0)
  swimsPerWeek      Int    @default(0)

  // Phase Customization
  taperWeeks Int @default(2)
  peakWeeks  Int @default(4)
  buildWeeks Int @default(4)

  // Preferred Training Days (0=Sunday, 1=Monday, ..., 6=Saturday)
  longRunDay Int @default(0) // Default Sunday
  workoutDay Int @default(3) // Default Wednesday
  restDays   Json @default("[1, 5]") // Default Monday & Friday as rest days

  // Status
  isActive    Boolean   @default(true)
  completedAt DateTime?

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workouts Workout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, isActive])
}

enum RaceType {
  FIVE_K
  TEN_K
  HALF_MARATHON
  MARATHON
}

model Workout {
  id     String @id @default(cuid())
  goalId String

  // Scheduling
  scheduledDate DateTime

  // Workout details
  workoutType WorkoutType
  description String
  phase       PlanPhase @default(BASE)
  order       Int       @default(0)
  notes       String?

  // Targets
  targetDistance Float? // meters
  targetDuration Int? // seconds
  targetPace     Float? // sec/km
  targetHrZone   Int? // 1-5

  // Completion
  isCompleted      Boolean   @default(false)
  completedAt      DateTime?
  linkedActivityId String? // Link to actual activity

  // Relations
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([goalId, scheduledDate])
  @@index([goalId, isCompleted])
  @@index([linkedActivityId])
}

enum WorkoutType {
  EASY
  LONG_RUN
  TEMPO
  INTERVALS
  REPETITIONS
  RECOVERY
  RACE
  REST
  CROSS_TRAIN
  RIDE
  SWIM
  STRENGTH
  OTHER
}

enum PlanPhase {
  BASE
  BUILD
  PEAK
  TAPER
  RACE_WEEK
  RECOVERY
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

// ============================================
// API Keys for External Access
// ============================================

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @unique // One key per user
  keyHash    String    // SHA-256 hash of the API key
  keyPrefix  String    // First 8 chars for display (e.g., "rf_abc12...")
  name       String    @default("My API Key")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  expiresAt  DateTime? // Optional expiration

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([keyHash])
}
