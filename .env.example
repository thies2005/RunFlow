# ===========================================
# RunFlow Environment Configuration
# ===========================================
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql://runflow:runflow@db:5432/runflow

# PostgreSQL Credentials (for docker-compose)
# Change these in production!
POSTGRES_USER=runflow
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=runflow

# NextAuth.js
NEXTAUTH_SECRET=your-nextauth-secret-generate-with-openssl-rand-base64-32
NEXTAUTH_URL=https://your-domain.com

# Strava API
# Get these from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Strava Webhook Verification Token
# This should be a random string you define
STRAVA_VERIFY_TOKEN=your-random-verification-token

# Cloudflare Tunnel (Optional)
# Get this from https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
TUNNEL_TOKEN=

