<?xml version="1.0" encoding="utf-8"?>
<!-- Auto-backup rules for Android 6–11 (API < 31), referenced by
     android:fullBackupContent in the manifest.

     Policy (Decision U8 / P0-6):
     1. AuthStore credentials (runflow_auth.preferences_pb) are excluded from cloud backup.
     2. Unencrypted Room database is excluded from cloud backup to protect user privacy.
     Preferences / non-sensitive app settings are retained. -->
<full-backup-content>
    <exclude domain="file" path="datastore/runflow_auth.preferences_pb" />
    <exclude domain="database" path="." />
</full-backup-content>
